# --- Contracts (Robinhood Chain, chain id 4663) ---------------------------------
# Leave these unset to run against the reference deployment (the OSSO Markets
# contracts, identical interface). After `cd contracts && npm run deploy:robinhood`
# paste the four addresses the script prints.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=
NEXT_PUBLIC_PERP_ENGINE_ADDRESS=
# USDG (6 decimals). Only change it for a local node with MockUSDG.
NEXT_PUBLIC_USDG_ADDRESS=

# --- Chain -------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_FALLBACKS=https://robinhood-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Local hardhat node: NEXT_PUBLIC_CHAIN_ID=31337 NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8961 NEXT_PUBLIC_MULTICALL3=

# --- Wallets -------------------------------------------------------------------------
# Optional. Without it only injected (browser) wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Site ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hunch.markets
