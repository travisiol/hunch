# Private key of the wallet that deploys and owns the three contracts. Never commit.
DEPLOYER_PRIVATE_KEY=
# Where the 2% prediction fee goes. Defaults to the deployer.
FEE_RECIPIENT=
# USDG on Robinhood Chain (6 decimals). Leave as is on mainnet; unset locally to deploy a mock.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Initial engine capital, in USDG, deposited into the perp engine at deploy time (the treasury is the counterparty).
ENGINE_CAPITAL=0
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
